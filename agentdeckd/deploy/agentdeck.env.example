# AgentDeck daemon 环境变量（复制到 /etc/agentdeck/agentdeck.env，权限 0600）
AGENTDECK_TOKEN=换成一个足够长的随机串
AGENTDECK_REPO=yjjqiu/agentloop

# 服务用户能看到的 CLI 目录；npm 全局安装在 /opt/agentdeck/npm-global 时这样写。
PATH=/opt/agentdeck/npm-global/bin:/usr/local/bin:/usr/bin:/bin

# 可选：私有仓库检查更新用的只读令牌（Fine-grained token，只授权本仓库 Contents: Read-only）
# 不配的话「设置 → 关于」里的更新检查会提示仓库不存在或无权访问
# GITHUB_TOKEN=github_pat_xxx